rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: app_data
    // Document ID: {key} (Format: prefix_type_userId)
    // Fields:
    //   - data: any (required) - The actual data payload
    //   - updatedAt: number (required) - Timestamp of update
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica se a chave do documento contém o UID do usuário
    // O formato esperado é gestao93_tipo_UID
    function isKeyOwner(key) {
      return isAuthenticated() && 
             (key.matches(".*" + request.auth.uid + "$") || 
              key.matches(".*" + request.auth.uid));
    }

    function isValidAppData(data) {
      return data.keys().hasAll(['data', 'updatedAt']) &&
             data.updatedAt is number;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /app_data/{key} {
      allow read, write: if isKeyOwner(key) && (request.method == 'delete' || isValidAppData(request.resource.data));
    }

    match /test/connection {
      allow read: if true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
